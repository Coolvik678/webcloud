18:T9f3,{"@context":"https://schema.org","@graph":[{"@type":"Service","@id":"https://webcloud.studio/en/services/online-shops#service","name":"Online shops","serviceType":"Online shops","description":"A shop that fits your products, not the other way round. Products, variants, payment, shipping and invoices work together, and running it stays simple. If you like, connected to your stock, a print-on-demand service or your accounting.","url":"https://webcloud.studio/en/services/online-shops","image":"https://webcloud.studio/api/media/file/service-shop.jpeg","provider":{"@id":"https://webcloud.studio/#studio"},"areaServed":[{"@type":"City","name":"Global Cloud Studio"},{"@type":"City","name":"Sobha Privy"},{"@type":"City","name":"Königswiesen"},{"@type":"City","name":"Dorfstetten"},{"@type":"City","name":"Pabneukirchen"},{"@type":"City","name":"Bärnkopf"},{"@type":"City","name":"Altmelon"},{"@type":"AdministrativeArea","name":"Mühlviertel"},{"@type":"Country","name":"Austria"}],"offers":{"@type":"Offer","priceSpecification":{"@type":"PriceSpecification","minPrice":4,"priceCurrency":"EUR"}}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"webcloud.","item":"https://webcloud.studio/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://webcloud.studio/en/services"},{"@type":"ListItem","position":3,"name":"Online shops","item":"https://webcloud.studio/en/services/online-shops"}]},{"@type":"FAQPage","@id":"https://webcloud.studio/en/services/online-shops#faq","mainEntity":[{"@type":"Question","name":"How much does an online shop cost?","acceptedAnswer":{"@type":"Answer","text":"From €4,900. The exact figure depends on your range, variants and integrations, for example with your stock or accounting. You get a fixed price in writing beforehand."}},{"@type":"Question","name":"Which payment methods are possible?","acceptedAnswer":{"@type":"Answer","text":"Card payments via Stripe, plus Klarna and PayPal. You decide which o