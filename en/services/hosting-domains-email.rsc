18:Ta94,{"@context":"https://schema.org","@graph":[{"@type":"Service","@id":"https://webcloud.studio/en/services/hosting-domains-email#service","name":"Hosting, domains & email","serviceType":"Hosting, domains & email","description":"Domain, mailboxes, certificate, server, backups, updates: everything runs in the background on fast servers in Europe. I set up your addresses so emails arrive and stay out of spam, and move existing domains and mailboxes without downtime. You do not have to worry about a thing. And if something comes up, you reach me, not a hotline.","url":"https://webcloud.studio/en/services/hosting-domains-email","image":"https://webcloud.studio/api/media/file/service-hosting.jpeg","provider":{"@id":"https://webcloud.studio/#studio"},"areaServed":[{"@type":"City","name":"Global Cloud Studio"},{"@type":"City","name":"Sobha Privy"},{"@type":"City","name":"Königswiesen"},{"@type":"City","name":"Dorfstetten"},{"@type":"City","name":"Pabneukirchen"},{"@type":"City","name":"Bärnkopf"},{"@type":"City","name":"Altmelon"},{"@type":"AdministrativeArea","name":"Mühlviertel"},{"@type":"Country","name":"Austria"}],"offers":{"@type":"Offer","priceSpecification":{"@type":"PriceSpecification","minPrice":50,"priceCurrency":"EUR"}}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"webcloud.","item":"https://webcloud.studio/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://webcloud.studio/en/services"},{"@type":"ListItem","position":3,"name":"Hosting, domains & email","item":"https://webcloud.studio/en/services/hosting-domains-email"}]},{"@type":"FAQPage","@id":"https://webcloud.studio/en/services/hosting-domains-email#faq","mainEntity":[{"@type":"Question","name":"How much do hosting, domain and email cost?","acceptedAnswer":{"@type":"Answer","text":"From €50 a month, including server, certificate, backups, updates and support. How many mailboxes and domains you need, we settle beforehand."}},{"@type":"Questio