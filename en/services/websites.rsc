d":{"@type":"Service","name":"Online shops","description":"Sell without worrying about technology.","url":"https://webcloud.studio/en/services/online-shops"},"priceSpecification":{"@type":"PriceSpecification","minPrice":4,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Custom software & apps","description":"Software that follows your process.","url":"https://webcloud.studio/en/services/custom-software-apps"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Brand & logo","description":"A mark that stays.","url":"https://webcloud.studio/en/services/brand-logo"},"priceSpecification":{"@type":"PriceSpecification","minPrice":500,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Photography & content","description":"Pictures that belong to your presence.","url":"https://webcloud.studio/en/services/photography-content"},"priceSpecification":{"@type":"PriceSpecification","minPrice":500,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Hosting, domains & email","description":"It just runs. And if not, you call me.","url":"https://webcloud.studio/en/services/hosting-domains-email"},"priceSpecification":{"@type":"PriceSpecification","minPrice":50,"priceCurrency":"EUR"}}]},"founder":{"@id":"https://webcloud.studio/#person"},"sameAs":["https://www.instagram.com/webcloud.studio_official/","https://www.youtube.com/@MeticStudio"]},{"@type":"Person","@id":"https://webcloud.studio/#person","name":"WebCloud Studio","jobTitle":"Designer and developer","worksFor":{"@id":"https://webcloud.studio/#studio"},"url":"https://webcloud.studio/en/studio","sameAs":["https://manuel-mayrhofer.tech"]},{"@type":"WebSite","@id":"https://webcloud.studio/#website","url":"https://webcloud.studio","name":"webcloud.","alternateName":["metic studio","webcloud.studio","webcloud"],"inLanguage":["de-AT","en"],"publisher":{"@id":"https://webcloud.studio/#studio"}}]}7:["$","html",null,{"lang":"en","classNa