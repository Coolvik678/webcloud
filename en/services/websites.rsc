18:Tbf8,{"@context":"https://schema.org","@graph":[{"@type":"Service","@id":"https://webcloud.studio/en/services/websites#service","name":"Websites","serviceType":"Websites","description":"No theme, no template, no graveyard of plugins. Design and code by one person, built on Next.js and React. Fast enough that nobody waits for a page to load, with a content management system where you edit your content yourself.","url":"https://webcloud.studio/en/services/websites","image":"https://webcloud.studio/api/media/file/service-web.jpeg","provider":{"@id":"https://webcloud.studio/#studio"},"areaServed":[{"@type":"City","name":"Global Cloud Studio"},{"@type":"City","name":"Sobha Privy"},{"@type":"City","name":"Königswiesen"},{"@type":"City","name":"Dorfstetten"},{"@type":"City","name":"Pabneukirchen"},{"@type":"City","name":"Bärnkopf"},{"@type":"City","name":"Altmelon"},{"@type":"AdministrativeArea","name":"Mühlviertel"},{"@type":"Country","name":"Austria"}],"offers":{"@type":"Offer","priceSpecification":{"@type":"PriceSpecification","minPrice":1,"priceCurrency":"EUR"}}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"webcloud.","item":"https://webcloud.studio/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://webcloud.studio/en/services"},{"@type":"ListItem","position":3,"name":"Websites","item":"https://webcloud.studio/en/services/websites"}]},{"@type":"FAQPage","@id":"https://webcloud.studio/en/services/websites#faq","mainEntity":[{"@type":"Question","name":"How much does a website cost?","acceptedAnswer":{"@type":"Answer","text":"From €1,000 for a clear presence with a few pages. The exact price depends on the scope: number of pages, content, features such as bookings or a second language. After the first meeting you get a fixed price in writing, and it holds."}},{"@type":"Question","name":"Can I edit the content myself?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every website comes with a content management system that has exactly the fields you need: text, images, news, dates. A short training session is included."}},{"@type":"Question","name":"Will people find me on Google?","acceptedAnswer":{"@type":"Answer","text":"The technical foundation is built in: fast loading, clean addresses, a title and description for every page, structured data and a sitemap. For local searches a well-kept Google Business Profile matters too, and I am happy to help with it. Nobody can honestly promise you the top spot, but a solid foundation, yes."}},{"@type":"Question","name":"Do you come by for the first meeting?","acceptedAnswer":{"@type":"Answer","text":"In the Mühlviertel and around Perg, happily in person; otherwise online. The first meeting is free and without obligation."}},{"@type":"Question","name":"I already have a website. Is a rebuild worth it?","acceptedAnswer":{"@type":"Answer","text":"I look at the existing site and tell you honestly whether a revision is enough. With a rebuild your content moves over, and old addresses redirect to the new ones, so search results are not lost."}}]}]}b:["$","article",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],["$","section",null,{"className":"shell frame pb-14 pt-[calc(var(--nav-h)+2.5rem)] md:pb-24 md:pt-[calc(var(--nav-h)+4.5rem)]","children":["$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]
