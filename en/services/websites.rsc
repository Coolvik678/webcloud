3f:["$","div",null,{"className":"faq","data-x":"Question","data-note":"One click opens it. The answer is already in the HTML, for search engines too.","children":[["$","details","How much does a website cost?",{"className":"faq-item","name":"faq","children":[["$","summary",null,{"className":"faq-q","children":[["$","span",null,{"className":"measure w-8 shrink-0 pt-1.5","children":"01"}],["$","span",null,{"className":"display-4 min-w-0 flex-1","children":"How much does a website cost?"}],["$","span",null,{"className":"faq-plus","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"className":"max-w-[58ch] text-ink-2","children":"From €1,000 for a clear presence with a few pages. The exact price depends on the scope: number of pages, content, features such as bookings or a second language. After the first meeting you get a fixed price in writing, and it holds."}]}]]}],["$","details","Can I edit the content myself?",{"className":"faq-item","name":"faq","children":[["$","summary",null,{"className":"faq-q","children":[["$","span",null,{"className":"measure w-8 shrink-0 pt-1.5","children":"02"}],["$","span",null,{"className":"display-4 min-w-0 flex-1","children":"Can I edit the content myself?"}],["$","span",null,{"className":"faq-plus","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"className":"max-w-[58ch] text-ink-2","children":"Yes. Every website comes with a content management system that has exactly the fields you need: text, images, news, dates. A short training session is included."}]}]]}],["$","details","Will people find me on Google?",{"className":"faq-item","name":"faq","children":[["$","summary",null,{"className":"faq-q","children":[["$","span",null,{"className":"measure w-8 shrink-0 pt-1.5","children":"03"}],["$","span",null,{"className":"display-4 min-w-0 flex-1","children":"Will people find me on Google?"}],["$","span",null,{"className":"faq-plus","aria-hidden":"true"}]]}],["$","d