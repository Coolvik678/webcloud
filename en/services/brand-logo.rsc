18:T953,{"@context":"https://schema.org","@graph":[{"@type":"Service","@id":"https://webcloud.studio/en/services/brand-logo#service","name":"Brand & logo","serviceType":"Brand & logo","description":"A logo is not a picture but a system: mark, type, colour and spacing that together express an attitude. I design brands that work on a business card just as well as on a façade or in an app.","url":"https://webcloud.studio/en/services/brand-logo","image":"https://webcloud.studio/api/media/file/service-design.jpeg","provider":{"@id":"https://webcloud.studio/#studio"},"areaServed":[{"@type":"City","name":"Global Cloud Studio"},{"@type":"City","name":"Sobha Privy"},{"@type":"City","name":"Königswiesen"},{"@type":"City","name":"Dorfstetten"},{"@type":"City","name":"Pabneukirchen"},{"@type":"City","name":"Bärnkopf"},{"@type":"City","name":"Altmelon"},{"@type":"AdministrativeArea","name":"Mühlviertel"},{"@type":"Country","name":"Austria"}],"offers":{"@type":"Offer","priceSpecification":{"@type":"PriceSpecification","minPrice":500,"priceCurrency":"EUR"}}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"webcloud.","item":"https://webcloud.studio/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://webcloud.studio/en/services"},{"@type":"ListItem","position":3,"name":"Brand & logo","item":"https://webcloud.studio/en/services/brand-logo"}]},{"@type":"FAQPage","@id":"https://webcloud.studio/en/services/brand-logo#faq","mainEntity":[{"@type":"Question","name":"How much does a logo cost?","acceptedAnswer":{"@type":"Answer","text":"From €500 for wordmark and symbol with colours and type. With stationery and a fuller brand guide accordingly more; you know the fixed price beforehand."}},{"@type":"Question","name":"How many drafts do I get?","acceptedAnswer":{"@type":"Answer","text":"Three directions, each with an honest assessment. We develop one of them together down to the details."}},{"@type":"Question","name":"Which files do I