a:["$L15",["$","section",null,{"className":"shell frame grid gap-10 md:grid-cols-12 md:gap-16","children":[["$","$L1d",null,{"className":"md:col-span-5","children":["$","$L1e",null,{"label":"Portrait","data-note":"The portrait sits in the same frame as every project image.","children":["$","$L1f",null,{"label":"Portrait · 3:4","children":["$","div",null,{"className":"relative aspect-[3/4] overflow-hidden rounded-[var(--radius-media)] border border-line bg-paper-2","children":[["$","$L20",null,{"src":"/img/studio-werkbank.jpg","alt":"Ruler, pencil, magnifier and a red dot on paper: the workbench of webcloud.","fill":true,"priority":true,"sizes":"(min-width: 768px) 40vw, 100vw","className":"parallax-img object-cover"}],["$","$L21",null,{"children":["$","$L22",null,{"style":{"left":"1.2rem","bottom":"1.2rem"},"tilt":-4,"children":"Photo coming. Promise."}]}]]}]}]}]}],["$","$L23",null,{"index":1,"className":"md:col-span-7 md:pt-4","children":[["$","div",null,{"className":"prose","children":[["$","p","0",{"children":[["$","$1","0",{"children":"It started with a question I could not let go of: why do most websites look the same? Not similar, but the same. The same site builders, the same spacing, the same language. And behind them, companies that are anything but interchangeable."}]]}],["$","p","1",{"children":[["$","$1","0",{"children":"So I started doing it differently. First out of curiosity, then as a craft, today as webcloud. I design and develop as one person. That means no design that gets watered down in the build, and no programmer who misreads a design. What I draw, I also build, down to the last pixel."}]]}],["$","p","2",{"children":[["$","$1","0",{"children":"The name comes from meticulous. That is not a marketing word but a way of working: I move an edge by two pixels if it sits two pixels wrong. I rewrite a function if it works but is not beautiful. That takes time. And it is the reason the results look different."}]]}]]}],["$","p",null,{"className":"measure relative mt-8 inline-block","children":["WebCloud Studio, founder of webcloud.",["$","$L24",null,{"letter":"N","note":"N for night shift.","className":"-top-3 left-[calc(100%+1.5rem)] max-md:left-0 max-md:top-10"}]]}]]}]]}],["$","div",null,{"className":"mt-24 md:mt-40","children":["$","$L25",null,{}]}],["$","section",null,{"className":"shell frame mt-24 md:mt-40","aria-label":"Stories","children":[["$","$L23",null,{"as":"h2","variant":"focus","className":"display-2 max-w-[16ch]","data-x":"Heading","data-x-font":true,"data-chapter":"Stories","children":["$","$L26",null,{"text":"Stories"}]}],["$","ul",null,{"className":"mt-12 grid gap-12 md:grid-cols-3 md:gap-10","children":[["$","$L23","6ab3f9516943c69700051b80",{"as":"li","index":0,"className":"rule pt-6","data-sketch-scope":true,"data-x":"Story","data-note":"First the line, then 24 pixels of air, then the story.","children":[["$","$L27",null,{"kind":"beat","className":"mb-6 max-w-[260px]"}],["$","h3",null,{"className":"display-4","children":"What a DJ and a developer have in common"}],["$","p",null,{"className":"mt-4 text-ink-2","children":"Both work with something you cannot see: timing. When you play a set, an eighth note decides whether a transition carries or the dance floor empties. The web is the same. An animation that runs 200 milliseconds too long feels sluggish. One that is 100 too short feels hectic. Nobody can name it, but everyone feels it. I learned the feel for it behind the decks, long before I needed it in code."}]]}],["$","$L23","6ab3f9516943c69700051b81",{"as":"li","index":1,"className":"rule pt-6","data-sketch-scope":true,"data-x":"Story","data-note":"First the line, then 24 pixels of air, then the story.","children":[["$","$L27",null,{"kind":"pixel","className":"mb-6 max-w-[260px]"}],["$","h3",null,{"className":"display-4","children":"The two-pixel evening"}],["$","p",null,{"className":"mt-4 text-ink-2","children":"It was just after midnight, the project signed off, the invoice written. And I noticed that a divider in the footer sat two pixels too low. Two pixels. Nobody would ever have seen it. I fixed it anyway, published again and only then went to bed. If you want to know what webcloud. means: that is it."}]]}],"$L28","$L29"]}]]}],"$L2a","$L2b","$L2c","$L2d","$L2e"]
