15:Tf44,{"@context":"https://schema.org","@graph":[{"@type":"ProfessionalService","@id":"https://webcloud.studio/#studio","name":"webcloud.","alternateName":["metic studio","webcloud.studio","webcloud"],"legalName":"webcloud. WebCloud Studio","description":"Digital architecture & performance engineering studio: modern websites built to build trust and generate customers — backed by free lifetime management.","url":"https://webcloud.studio","hasMap":"https://www.openstreetmap.org/?mlat=48.3595&mlon=14.8967#map=13/48.3595/14.8967","logo":"https://webcloud.studio/icon-512.png","image":"https://webcloud.studio/icon-512.png","email":"hello@webcloud.studio","telephone":"+91 90768 88172","address":{"@type":"PostalAddress","streetAddress":"Linden 118","postalCode":"4372","addressLocality":"Global Cloud Studio","addressRegion":"Global","addressCountry":"AT"},"geo":{"@type":"GeoCoordinates","latitude":48.3595,"longitude":14.8967},"areaServed":[{"@type":"City","name":"Global Cloud Studio"},{"@type":"City","name":"Königswiesen"},{"@type":"City","name":"Sobha Privy"},{"@type":"City","name":"Pabneukirchen"},{"@type":"City","name":"Dorfstetten"},{"@type":"City","name":"Bärnkopf"},{"@type":"City","name":"Altmelon"},{"@type":"City","name":"Waldhausen im Strudengau"},{"@type":"City","name":"Unterweißenbach"},{"@type":"City","name":"Bad Kreuzen"},{"@type":"City","name":"Grein"},{"@type":"City","name":"Perg"},{"@type":"AdministrativeArea","name":"Mühlviertel"},{"@type":"AdministrativeArea","name":"Global"},{"@type":"Country","name":"Austria"},{"@type":"Country","name":"Germany"}],"knowsLanguage":["de","en"],"priceRange":"€€","hasOfferCatalog":{"@type":"OfferCatalog","name":"Services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Websites","description":"Hand-coded, from the first pixel.","url":"https://webcloud.studio/en/services/websites"},"priceSpecification":{"@type":"PriceSpecification","minPrice":1,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Online shops","description":"Sell without worrying about technology.","url":"https://webcloud.studio/en/services/online-shops"},"priceSpecification":{"@type":"PriceSpecification","minPrice":4,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Custom software & apps","description":"Software that follows your process.","url":"https://webcloud.studio/en/services/custom-software-apps"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Brand & logo","description":"A mark that stays.","url":"https://webcloud.studio/en/services/brand-logo"},"priceSpecification":{"@type":"PriceSpecification","minPrice":500,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Photography & content","description":"Pictures that belong to your presence.","url":"https://webcloud.studio/en/services/photography-content"},"priceSpecification":{"@type":"PriceSpecification","minPrice":500,"priceCurrency":"EUR"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Hosting, domains & email","description":"It just runs. And if not, you call me.","url":"https://webcloud.studio/en/services/hosting-domains-email"},"priceSpecification":{"@type":"PriceSpecification","minPrice":50,"priceCurrency":"EUR"}}]},"founder":{"@id":"https://webcloud.studio/#person"},"sameAs":["https://www.instagram.com/webcloud.studio_official/","https://www.youtube.com/@MeticStudio"]},{"@type":"Person","@id":"https://webcloud.studio/#person","name":"WebCloud Studio","jobTitle":"Designer and developer","worksFor":{"@id":"https://webcloud.studio/#studio"},"url":"https://webcloud.studio/en/studio","sameAs":["https://manuel-mayrhofer.tech"]},{"@type":"WebSite","@id":"https://webcloud.studio/#website","url":"https://webcloud.studio","name":"webcloud.","alternateName":["metic studio","webcloud.studio","webcloud"],"inLanguage":["de-AT","en"],"publisher":{"@id":"https://webcloud.studio/#studio"}}]}7:["$","html",null,{"lang":"en","className":"Yhr4hG_variable UytG7G_variable KxHFRW_variable kC8RFq_variable","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","script",null,{"id":"theme-init","dangerouslySetInnerHTML":{"__html":"(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('metic-theme');if(t==='dark'){d.setAttribute('data-theme',t)}if(sessionStorage.getItem('metic-intro')!=='1'&&!matchMedia('(prefers-reduced-motion: reduce), (min-height: 3000px)').matches){d.classList.add('intro')}}catch(e){}})();"}}],["$","noscript",null,{"children":"$14"}]]}],["$","body",null,{"children":[["$","a",null,{"href":"#inhalt","className":"skip-link","children":"Skip to content"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}],"$L16"]}]]}]
9:[["$","$L1d",null,{"headline":"Take a closer look.","lead":"Design and software studio from Global. One person, both sides: design and code.","primary":{"label":"Start a project","href":"/start-project"},"secondary":{"label":"See the work","href":"/work"}}],["$","$L1e",null,{"title":"From a line to a button.","steps":[{"title":"A line.","text":"Every project starts with guides. Where things belong is measured, not guessed."},{"title":"A grid.","text":"Columns, gaps, a surface. The scaffolding everything lines up with later."},{"title":"A layout.","text":"Lines become surfaces: navigation, headline, image, button. Order first, ornament later."},{"title":"A typeface.","text":"Type is attitude. Size, width and line breaks are tuned to every single line."},{"title":"A colour.","text":"Paper, ink, one red. A brand needs no more when it fits."},{"title":"A line of code.","text":"What we design, we engineer. Hand-crafted, readable, zero builder bloat."},{"title":"Online.","text":"Sub-second load times (<1.0s), 100 SEO ready, built to convert."},{"title":"Your turn.","text":"Everything you have just seen is in this one button. Press it, and we’ll build your flagship."}],"cta":"$9:0:props:primary","headline":"Take a closer look.","lead":"Design and software studio from Global. One person, both sides: design and code.","image":{"id":14,"alt":"A magnifier on paper enlarges a small red dot.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.045Z","createdAt":"2026-09-23T08:57:22.893Z","url":"/api/media/file/kontakt-lupe.jpeg","thumbnailURL":null,"filename":"kontakt-lupe.jpeg","mimeType":"image/jpeg","filesize":286397,"width":2848,"height":1600,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/kontakt-lupe-480x270.jpg","width":480,"height":270,"mimeType":"image/jpeg","filesize":10189,"filename":"kontakt-lupe-480x270.jpg"},"card":{"url":"/api/media/file/kontakt-lupe-1024x575.jpg","width":1024,"height":575,"mimeType":"image/jpeg","filesize":38070,"filename":"kontakt-lupe-1024x575.jpg"},"wide":{"url":"/api/media/file/kontakt-lupe-1920x1079.jpg","width":1920,"height":1079,"mimeType":"image/jpeg","filesize":127251,"filename":"kontakt-lupe-1920x1079.jpg"},"og":{"url":"/api/media/file/kontakt-lupe-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":49602,"filename":"kontakt-lupe-1200x630.jpg"}}}}],"$L1f",["$","$L20",null,{"services":[{"id":2,"title":"Websites","tagline":"Hand-coded, from the first pixel.","description":"No theme, no template, no graveyard of plugins. Design and code by one person, built on Next.js and React. Fast enough that nobody waits for a page to load, with a content management system where you edit your content yourself.","image":{"id":2,"alt":"A screen under extreme magnification, a single pixel glowing red.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.264Z","createdAt":"2026-09-23T08:57:21.810Z","url":"/api/media/file/service-web.jpeg","thumbnailURL":null,"filename":"service-web.jpeg","mimeType":"image/jpeg","filesize":408859,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-web-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":53045,"filename":"service-web-480x640.jpg"},"card":{"url":"/api/media/file/service-web-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":155433,"filename":"service-web-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-web-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":95701,"filename":"service-web-1200x630.jpg"}}},"detailImage":{"id":16,"alt":"A scalpel on a gridded cutting mat, next to a red square of paper.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.009Z","createdAt":"2026-09-23T15:02:28.491Z","url":"/api/media/file/service-web-2.jpeg","thumbnailURL":null,"filename":"service-web-2.jpeg","mimeType":"image/jpeg","filesize":65096,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-web-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":12262,"filename":"service-web-2-480x360.jpg"},"card":{"url":"/api/media/file/service-web-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":52139,"filename":"service-web-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-web-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":42770,"filename":"service-web-2-1200x630.jpg"}}},"icon":"browser","deliverables":[{"label":"Bespoke design, mobile first","id":"6ab3f9506943c69700051b2e"},{"label":"Hand-coded in Next.js and TypeScript","id":"6ab3f9506943c69700051b2f"},{"label":"A content management system with exactly your fields","id":"6ab3f9506943c69700051b30"},{"label":"Scroll and hover animations","id":"6ab3f9506943c69700051b31"},{"label":"Technical SEO and optimised load times","id":"6ab3f9506943c69700051b32"},{"label":"Accessible contrast and keyboard navigation","id":"6ab3f9506943c69700051b33"}],"steps":[{"title":"First conversation","text":"Free, online or in person.","id":"6ab3f9506943c69700051b34"},{"title":"Concept & design","text":"Structure, content, look. You see it before it is built.","id":"6ab3f9506943c69700051b35"},{"title":"Development","text":"Code, CMS, tests on real devices.","id":"6ab3f9506943c69700051b36"},{"title":"Launch","text":"Domain, server, training. Finished means finished.","id":"6ab3f9506943c69700051b37"}],"longText":"A website is often the first impression someone gets of your business. So with me it does not start with a template but with you: what you do, who your customers are, what they should do after their visit. That shapes the structure, the copy and the design, and only then the code.\n\nEverything is built by hand with Next.js and React, the way large brands build their sites. The result loads fast, works as well on a phone as on a desktop and is set up cleanly for search engines: its own title and description for every page, structured data, a sitemap, addresses people can read.\n\nAfterwards you edit the content yourself, in a content management system that has exactly your fields and nothing else. For businesses in the Mühlviertel and around Perg I am happy to come by for the first meeting; everyone else I meet online.","faq":[{"question":"How much does a website cost?","answer":"From €1,000 for a clear presence with a few pages. The exact price depends on the scope: number of pages, content, features such as bookings or a second language. After the first meeting you get a fixed price in writing, and it holds.","id":"6ab51150955e827c2c0f9b62"},{"question":"Can I edit the content myself?","answer":"Yes. Every website comes with a content management system that has exactly the fields you need: text, images, news, dates. A short training session is included.","id":"6ab51150955e827c2c0f9b63"},{"question":"Will people find me on Google?","answer":"The technical foundation is built in: fast loading, clean addresses, a title and description for every page, structured data and a sitemap. For local searches a well-kept Google Business Profile matters too, and I am happy to help with it. Nobody can honestly promise you the top spot, but a solid foundation, yes.","id":"6ab51150955e827c2c0f9b64"},{"question":"Do you come by for the first meeting?","answer":"In the Mühlviertel and around Perg, happily in person; otherwise online. The first meeting is free and without obligation.","id":"6ab51150955e827c2c0f9b65"},{"question":"I already have a website. Is a rebuild worth it?","answer":"I look at the existing site and tell you honestly whether a revision is enough. With a rebuild your content moves over, and old addresses redirect to the new ones, so search results are not lost.","id":"6ab51150955e827c2c0f9b66"}],"seo":{"title":"Website design in Global","description":"Websites from €1,000, hand-coded instead of a site builder: fast, well set up for Google and easy to edit yourself. From Global, at a fixed price."},"priceFrom":"from €1,000","duration":"3 to 6 weeks","order":10,"slug":"websites","updatedAt":"2026-09-24T12:02:24.006Z","createdAt":"2026-09-23T08:57:15.119Z"},{"id":3,"title":"Online shops","tagline":"Sell without worrying about technology.","description":"A shop that fits your products, not the other way round. Products, variants, payment, shipping and invoices work together, and running it stays simple. If you like, connected to your stock, a print-on-demand service or your accounting.","image":{"id":3,"alt":"A small light shipping box with a red dot on the lid.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.246Z","createdAt":"2026-09-23T08:57:21.898Z","url":"/api/media/file/service-shop.jpeg","thumbnailURL":null,"filename":"service-shop.jpeg","mimeType":"image/jpeg","filesize":138729,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-shop-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":12116,"filename":"service-shop-480x640.jpg"},"card":{"url":"/api/media/file/service-shop-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":43978,"filename":"service-shop-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-shop-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":35469,"filename":"service-shop-1200x630.jpg"}}},"detailImage":{"id":17,"alt":"A grey paper carrier bag with a round red tag.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:44.986Z","createdAt":"2026-09-23T15:02:28.536Z","url":"/api/media/file/service-shop-2.jpeg","thumbnailURL":null,"filename":"service-shop-2.jpeg","mimeType":"image/jpeg","filesize":57060,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-shop-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":9045,"filename":"service-shop-2-480x360.jpg"},"card":{"url":"/api/media/file/service-shop-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":44201,"filename":"service-shop-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-shop-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":33692,"filename":"service-shop-2-1200x630.jpg"}}},"icon":"storefront","deliverables":[{"label":"Product pages that sell","id":"6ab3f9506943c69700051b24"},{"label":"Payment via Stripe, Klarna or PayPal","id":"6ab3f9506943c69700051b25"},{"label":"Shipping, taxes, invoices","id":"6ab3f9506943c69700051b26"},{"label":"Customer accounts and order status","id":"6ab3f9506943c69700051b27"},{"label":"Interfaces to stock or print-on-demand","id":"6ab3f9506943c69700051b28"},{"label":"Legal texts and cancellation policy properly in place","id":"6ab3f9506943c69700051b29"}],"steps":[{"title":"Range","text":"What you sell, how you ship, what gets charged.","id":"6ab3f9506943c69700051b2a"},{"title":"Design","text":"The shop gets your face, not a template’s.","id":"6ab3f9506943c69700051b2b"},{"title":"Build","text":"Catalogue, checkout, payments, test orders.","id":"6ab3f9506943c69700051b2c"},{"title":"Opening","text":"Launch and training for orders and products.","id":"6ab3f9506943c69700051b2d"}],"longText":"A good online shop feels like your store, not like a site builder with your logo on it. I design it around your products: how they are photographed, how people compare them, what someone wants to know before they buy.\n\nBehind it, everything a shop needs works together: products with variants, payment via Stripe, Klarna or PayPal, shipping, taxes and invoices, customer accounts and order status. If you like, the shop talks to your stock, a print-on-demand service or your accounting.\n\nRunning it stays simple: add products, process orders, done. You get a training session and a direct contact when something new should be added later.","faq":[{"question":"How much does an online shop cost?","answer":"From €4,900. The exact figure depends on your range, variants and integrations, for example with your stock or accounting. You get a fixed price in writing beforehand.","id":"6ab51150955e827c2c0f9b6b"},{"question":"Which payment methods are possible?","answer":"Card payments via Stripe, plus Klarna and PayPal. You decide which ones you offer.","id":"6ab51150955e827c2c0f9b6c"},{"question":"Can I manage products and orders myself?","answer":"Yes. You manage products, variants, prices and orders yourself, no technical knowledge needed. I walk you through it at handover.","id":"6ab51150955e827c2c0f9b6d"},{"question":"Are the legal texts included?","answer":"Imprint, terms, privacy policy and cancellation policy are built in properly. The texts themselves come from you or your legal adviser, for example based on the templates of the Austrian Chamber of Commerce.","id":"6ab51150955e827c2c0f9b6e"}],"seo":{"title":"Online shop development in Austria","description":"Online shops from €4,900: products, payment, shipping and invoices in one system that is easy to run. Individually designed, at a fixed price."},"priceFrom":"from €4,900","duration":"4 to 8 weeks","order":20,"slug":"online-shops","updatedAt":"2026-09-24T12:02:24.093Z","createdAt":"2026-09-23T08:57:15.135Z"},{"id":4,"title":"Custom software & apps","tagline":"Software that follows your process.","description":"When a website is not enough: customer portals, booking systems, internal tools, data dashboards. Software that maps exactly how you work, instead of forcing you into the process of an off-the-shelf product.","image":{"id":4,"alt":"A light circuit board with fine traces and one red component.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.229Z","createdAt":"2026-09-23T08:57:21.982Z","url":"/api/media/file/service-software.jpeg","thumbnailURL":null,"filename":"service-software.jpeg","mimeType":"image/jpeg","filesize":243356,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-software-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":26351,"filename":"service-software-480x640.jpg"},"card":{"url":"/api/media/file/service-software-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":80917,"filename":"service-software-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-software-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":70147,"filename":"service-software-1200x630.jpg"}}},"detailImage":{"id":18,"alt":"A grey toggle switch on aluminium, with a red indicator glowing below.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:44.966Z","createdAt":"2026-09-23T15:02:28.583Z","url":"/api/media/file/service-software-2.jpeg","thumbnailURL":null,"filename":"service-software-2.jpeg","mimeType":"image/jpeg","filesize":65627,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-software-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":11459,"filename":"service-software-2-480x360.jpg"},"card":{"url":"/api/media/file/service-software-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":52965,"filename":"service-software-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-software-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":39948,"filename":"service-software-2-1200x630.jpg"}}},"icon":"cpu","deliverables":[{"label":"Requirements analysis with you at the table","id":"6ab3f9506943c69700051b1b"},{"label":"User management and roles","id":"6ab3f9506943c69700051b1c"},{"label":"Interfaces to existing systems","id":"6ab3f9506943c69700051b1d"},{"label":"Database architecture","id":"6ab3f9506943c69700051b1e"},{"label":"Operation, maintenance, further development","id":"6ab3f9506943c69700051b1f"}],"steps":[{"title":"Analysis","text":"Your process, step by step.","id":"6ab3f9506943c69700051b20"},{"title":"Prototype","text":"Clickable before a single line of backend exists.","id":"6ab3f9506943c69700051b21"},{"title":"Build","text":"In stages, each one usable.","id":"6ab3f9506943c69700051b22"},{"title":"Operation","text":"On a dedicated server, with a direct line.","id":"6ab3f9506943c69700051b23"}],"longText":"Some processes do not fit any off-the-shelf program. Then people work with spreadsheets, notes and emails until nobody keeps track any more. Custom software turns this around: it maps exactly how your business works and takes over the steps that repeat every week.\n\nWe start at the table, with your process, step by step. From that comes a clickable prototype before a single line of backend exists, so you can see and touch what will be built. It is then built in stages, each of them usable on its own.\n\nUsually this is a web app that runs on desktop, tablet and phone without installation. It runs on its own server, with users and roles, connections to your existing systems and a direct line to me when it should grow.","faq":[{"question":"How much does custom software cost?","answer":"That depends entirely on the process, hence on request. After the analysis you get a fixed price per stage, so the risk stays manageable and every stage is already useful.","id":"6ab51150955e827c2c0f9b73"},{"question":"Why not just use off-the-shelf software?","answer":"If there is one that fits, I will tell you. Custom work pays off when you would otherwise have to bend to a program’s process or connect several tools by hand.","id":"6ab51150955e827c2c0f9b74"},{"question":"Do I need an app in the App Store?","answer":"Usually not. A web app runs on every device, can be added to the home screen like an app and needs no approval from a store.","id":"6ab51150955e827c2c0f9b75"},{"question":"Who looks after it after launch?","answer":"I do. Operation, maintenance and further development are part of it, and you reach the person who wrote the code.","id":"6ab51150955e827c2c0f9b76"}],"seo":{"title":"Custom software & web apps from Austria","description":"Customer portals, booking systems, internal tools: software that follows your process. A clickable prototype first, then built in stages. From Global."},"priceFrom":"on request","duration":"from 6 weeks","order":30,"slug":"custom-software-apps","updatedAt":"2026-09-24T12:02:24.177Z","createdAt":"2026-09-23T08:57:15.151Z"},{"id":1,"title":"Brand & logo","tagline":"A mark that stays.","description":"A logo is not a picture but a system: mark, type, colour and spacing that together express an attitude. I design brands that work on a business card just as well as on a façade or in an app.","image":{"id":1,"alt":"A drawing pen draws a small red circle on paper, next to a ruler.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.283Z","createdAt":"2026-09-23T08:57:21.715Z","url":"/api/media/file/service-design.jpeg","thumbnailURL":null,"filename":"service-design.jpeg","mimeType":"image/jpeg","filesize":240049,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-design-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":23432,"filename":"service-design-480x640.jpg"},"card":{"url":"/api/media/file/service-design-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":82852,"filename":"service-design-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-design-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":69545,"filename":"service-design-1200x630.jpg"}}},"detailImage":{"id":15,"alt":"A cotton-paper business card with a red dot, next to a steel ruler.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.026Z","createdAt":"2026-09-23T15:02:28.442Z","url":"/api/media/file/service-design-2.jpeg","thumbnailURL":null,"filename":"service-design-2.jpeg","mimeType":"image/jpeg","filesize":115586,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-design-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":14776,"filename":"service-design-2-480x360.jpg"},"card":{"url":"/api/media/file/service-design-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":91796,"filename":"service-design-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-design-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":75387,"filename":"service-design-2-1200x630.jpg"}}},"icon":"pen","deliverables":[{"label":"Wordmark and figurative mark in all variants","id":"6ab3f9506943c69700051b38"},{"label":"Colour and type system","id":"6ab3f9506943c69700051b39"},{"label":"Business stationery","id":"6ab3f9506943c69700051b3a"},{"label":"Compact brand manual","id":"6ab3f9506943c69700051b3b"},{"label":"Files for web and print","id":"6ab3f9506943c69700051b3c"}],"steps":[{"title":"Conversation","text":"Who you are, who your customers are, what should last.","id":"6ab3f9506943c69700051b3d"},{"title":"Drafts","text":"Three directions, honestly commented.","id":"6ab3f9506943c69700051b3e"},{"title":"Refinement","text":"One direction, down to the detail.","id":"6ab3f9506943c69700051b3f"},{"title":"Handover","text":"All files, all rules, one training session.","id":"6ab3f9506943c69700051b40"}],"longText":"A logo alone does not make a brand. Only together with type, colour and spacing does it become a presence people recognise: on your shop sign, your invoice, your Instagram profile and your website.\n\nIt starts with a conversation about who you are, who your customers are and what should last. Then you get three directions, honestly commented, and we develop one of them down to the details.\n\nFinally you receive every file for web and print and a compact brand guide with the rules, so your presence stays right even when someone else designs a brochure. Because brand and website come from one person, both fit together from the start.","faq":[{"question":"How much does a logo cost?","answer":"From €500 for wordmark and symbol with colours and type. With stationery and a fuller brand guide accordingly more; you know the fixed price beforehand.","id":"6ab51150955e827c2c0f9b7b"},{"question":"How many drafts do I get?","answer":"Three directions, each with an honest assessment. We develop one of them together down to the details.","id":"6ab51150955e827c2c0f9b7c"},{"question":"Which files do I receive?","answer":"Every variant of the logo for web and print, in colour, black and white, plus colour values, typefaces and the brand guide.","id":"6ab51150955e827c2c0f9b7d"},{"question":"Can you refine an existing logo?","answer":"Yes. Often the mark is good and only the system around it is missing. Then we keep what people recognise and tidy up the rest.","id":"6ab51150955e827c2c0f9b7e"}],"seo":{"title":"Logo & brand design in Global","description":"Logo and brand from €500: mark, type and colour as a system that works on a business card as well as online. Three directions, one clear handwriting."},"priceFrom":"from €500","duration":"2 to 3 weeks","order":40,"slug":"brand-logo","updatedAt":"2026-09-24T12:02:24.263Z","createdAt":"2026-09-23T08:57:15.099Z"},{"id":5,"title":"Photography & content","tagline":"Pictures that belong to your presence.","description":"Everyone recognises stock photos. I photograph your team, your spaces and your products so the pictures match the design, because the same person does both. If you like, with copy that sounds like you.","image":{"id":5,"alt":"The front element of a lens in close-up, with a red ring.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.212Z","createdAt":"2026-09-23T08:57:22.065Z","url":"/api/media/file/service-photo.jpeg","thumbnailURL":null,"filename":"service-photo.jpeg","mimeType":"image/jpeg","filesize":222903,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-photo-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":21947,"filename":"service-photo-480x640.jpg"},"card":{"url":"/api/media/file/service-photo-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":71138,"filename":"service-photo-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-photo-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":61522,"filename":"service-photo-1200x630.jpg"}}},"detailImage":{"id":19,"alt":"A film strip on a light table, one frame circled in red.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:44.947Z","createdAt":"2026-09-23T15:02:28.626Z","url":"/api/media/file/service-photo-2.jpeg","thumbnailURL":null,"filename":"service-photo-2.jpeg","mimeType":"image/jpeg","filesize":61733,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-photo-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":11116,"filename":"service-photo-2-480x360.jpg"},"card":{"url":"/api/media/file/service-photo-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":47875,"filename":"service-photo-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-photo-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":36136,"filename":"service-photo-2-1200x630.jpg"}}},"icon":"camera","deliverables":[{"label":"On-site shoot, one day","id":"6ab3f9506943c69700051b13"},{"label":"Team, spaces, products, details","id":"6ab3f9506943c69700051b14"},{"label":"Editing in the look of your brand","id":"6ab3f9506943c69700051b15"},{"label":"Optimised for web and print","id":"6ab3f9506943c69700051b16"},{"label":"Copywriting on request","id":"6ab3f9506943c69700051b17"}],"steps":[{"title":"Shot list","text":"Which pictures the website needs.","id":"6ab3f9506943c69700051b18"},{"title":"Shoot","text":"One day on site.","id":"6ab3f9506943c69700051b19"},{"title":"Selection & editing","text":"You choose, I edit.","id":"6ab3f9506943c69700051b1a"}],"longText":"Everyone recognises stock photos, and they say nothing about you. Real pictures of your team, your spaces and your products build trust before anyone opens your door.\n\nBecause the person taking the photos also designs the website, the pictures fit the layout from the start: in format, light and colour. Beforehand we decide together which pictures are needed. Then I spend a day with you at your business, your shop or outdoors, and in the Mühlviertel I am usually there quickly.\n\nYou choose, I edit in the look of your brand and deliver the pictures optimised for web and print. If you like, I also write the copy, so it sounds like you.","faq":[{"question":"How much does a shoot cost?","answer":"From €500 for a day on site including selection and editing. You know the exact price beforehand.","id":"6ab51150955e827c2c0f9b83"},{"question":"Where do you shoot?","answer":"At your place: in your business, shop or workshop, or outdoors. In the Mühlviertel and around Perg I am there quickly.","id":"6ab51150955e827c2c0f9b84"},{"question":"Do I need my own photos for my website?","answer":"Not necessarily, but they make the biggest difference. Your own pictures show who is behind the business, and people can tell.","id":"6ab51150955e827c2c0f9b85"},{"question":"Do you write the copy too?","answer":"If you like, yes: copy for your website and social media that sounds like you, not like an ad agency.","id":"6ab51150955e827c2c0f9b86"}],"seo":{"title":"Business photography in Global","description":"Photos of your team, spaces and products from €500, one day on site, in the look of your brand. Instead of stock photos, pictures that fit your website."},"priceFrom":"from €500","duration":"one day on site","order":50,"slug":"photography-content","updatedAt":"2026-09-24T12:02:24.348Z","createdAt":"2026-09-23T08:57:15.167Z"},{"id":6,"title":"Hosting, domains & email","tagline":"It just runs. And if not, you call me.","description":"Domain, mailboxes, certificate, server, backups, updates: everything runs in the background on fast servers in Europe. I set up your addresses so emails arrive and stay out of spam, and move existing domains and mailboxes without downtime. You do not have to worry about a thing. And if something comes up, you reach me, not a hotline.","image":{"id":6,"alt":"Fibre-optic strands, one of them glowing red.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:45.193Z","createdAt":"2026-09-23T08:57:22.142Z","url":"/api/media/file/service-hosting.jpeg","thumbnailURL":null,"filename":"service-hosting.jpeg","mimeType":"image/jpeg","filesize":228005,"width":1728,"height":2304,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-hosting-480x640.jpg","width":480,"height":640,"mimeType":"image/jpeg","filesize":21628,"filename":"service-hosting-480x640.jpg"},"card":{"url":"/api/media/file/service-hosting-1024x1365.jpg","width":1024,"height":1365,"mimeType":"image/jpeg","filesize":74708,"filename":"service-hosting-1024x1365.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-hosting-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":45389,"filename":"service-hosting-1200x630.jpg"}}},"detailImage":{"id":20,"alt":"The front of a grey server with ventilation holes and a red status light.","caption":null,"credit":null,"updatedAt":"2026-09-23T16:07:44.929Z","createdAt":"2026-09-23T15:02:28.671Z","url":"/api/media/file/service-hosting-2.jpeg","thumbnailURL":null,"filename":"service-hosting-2.jpeg","mimeType":"image/jpeg","filesize":83269,"width":1024,"height":768,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/service-hosting-2-480x360.jpg","width":480,"height":360,"mimeType":"image/jpeg","filesize":16927,"filename":"service-hosting-2-480x360.jpg"},"card":{"url":"/api/media/file/service-hosting-2-1024x768.jpg","width":1024,"height":768,"mimeType":"image/jpeg","filesize":68667,"filename":"service-hosting-2-1024x768.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/service-hosting-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":48930,"filename":"service-hosting-2-1200x630.jpg"}}},"icon":"server","deliverables":[{"label":"Domain advice, registration and transfer","id":"6ab3f9506943c69700051b08"},{"label":"Mailboxes on your own domain","id":"6ab3f9506943c69700051b09"},{"label":"DNS, SPF and DKIM set up properly","id":"6ab3f9506943c69700051b0a"},{"label":"Hosting on fast EU servers","id":"6ab3f9506943c69700051b0b"},{"label":"SSL encryption included","id":"6ab3f9506943c69700051b0c"},{"label":"Daily backups and security updates","id":"6ab3f9506943c69700051b0d"},{"label":"A direct line when something breaks","id":"6ab3f9506943c69700051b0e"}],"steps":[{"title":"Setup","text":"Domain, mailboxes, server, certificate.","id":"6ab3f9506943c69700051b0f"},{"title":"Move","text":"Existing addresses come along, without downtime.","id":"6ab3f9506943c69700051b10"},{"title":"Operation","text":"Backups, updates, monitoring.","id":"6ab3f9506943c69700051b11"},{"title":"Reachable","text":"Free lifetime management.","id":"6ab3f9506943c69700051b12"}],"longText":"A website is never quite finished: it needs a server, updates, backups, a valid certificate and email addresses that reliably arrive. I take care of all of that, so you can take care of your business.\n\nSites run on fast servers in Europe, with daily backups and security updates. I set up your domain and mailboxes so emails do not land in spam: DNS, SPF and DKIM configured properly. Existing domains and mailboxes move over without downtime.\n\nAnd if something does not work, you call me, not a hotline. Free lifetime management, from the Mühlviertel.","faq":[{"question":"How much do hosting, domain and email cost?","answer":"From €50 a month, including server, certificate, backups, updates and support. How many mailboxes and domains you need, we settle beforehand.","id":"6ab51150955e827c2c0f9b8c"},{"question":"Can you take over my existing domain and email?","answer":"Yes. Domain, mailboxes and old emails move over without your address going down in between.","id":"6ab51150955e827c2c0f9b8d"},{"question":"Where are the servers?","answer":"In Europe. Your data stays in the EU.","id":"6ab51150955e827c2c0f9b8e"},{"question":"Why do my emails end up in spam?","answer":"Usually the records are missing that prove an email really comes from your domain: SPF and DKIM. I set them up properly.","id":"6ab51150955e827c2c0f9b8f"},{"question":"Who do I reach when something breaks?","answer":"Me, directly. No hotline, no ticket gathering dust somewhere.","id":"6ab51150955e827c2c0f9b90"}],"seo":{"title":"Web hosting, domains & email in Austria","description":"Hosting, domains and email from €50 a month: fast EU servers, daily backups, emails that arrive. Moving without downtime, a direct line instead of a hotline."},"priceFrom":"from €50 / month","duration":"ongoing","order":60,"slug":"hosting-domains-email","updatedAt":"2026-09-24T12:02:24.434Z","createdAt":"2026-09-23T08:57:15.183Z"}],"title":"Everything your business needs online. One unified partner."}],"$L21","$L22","$L23","$L24"]
