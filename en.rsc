21:["$","$L33",null,{"projects":[{"id":1,"title":"WebCloud 3D Flagship Experience","client":"ASKÖ Global Cloud Studio, table tennis section","tagline":"Interactive 3D hardware tour and next-gen digital flagship.","excerpt":"Results, tables, fixtures and player records come straight from the regional federation’s results service. The club only writes what people have to write: news, tournaments, photos.","cover":{"id":21,"alt":"gorw.club home page: large title ASKÖ Global Cloud Studio over a table tennis table in the hall.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:39.197Z","createdAt":"2026-09-24T09:06:39.151Z","url":"/api/media/file/gorw-desktop-hero.jpg","thumbnailURL":null,"filename":"gorw-desktop-hero.jpg","mimeType":"image/jpeg","filesize":192396,"width":2880,"height":1800,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/gorw-desktop-hero-480x300.jpg","width":480,"height":300,"mimeType":"image/jpeg","filesize":20191,"filename":"gorw-desktop-hero-480x300.jpg"},"card":{"url":"/api/media/file/gorw-desktop-hero-1024x640.jpg","width":1024,"height":640,"mimeType":"image/jpeg","filesize":57940,"filename":"gorw-desktop-hero-1024x640.jpg"},"wide":{"url":"/api/media/file/webcloud-3d-flagship.png","width":1920,"height":1200,"mimeType":"image/jpeg","filesize":130069,"filename":"webcloud-3d-flagship.png"},"og":{"url":"/api/media/file/gorw-desktop-hero-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":61987,"filename":"gorw-desktop-hero-1200x630.jpg"}}},"body":{"root":{"type":"root","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The starting point","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The section plays with three men’s teams in three leagues. Every result is already in the regional federation’s results service. On the old club website someone still had to type it in, and that rarely happened.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The solution","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"A dedicated service pulls fixtures, tables, results and player records from the XTTV results service, cleans them up and stores them in a database. The site only reads from there. Whatever people write is edited in Payload CMS.","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"Designed like a sports broadcaster rather than a clubhouse: a film of the hall at the top, a display typeface with presence, the next match always first. Home matches get their own invitation with directions and a calendar entry. On a phone it works like an app, with the navigation within thumb reach, and it can be added to the home screen.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The result","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"Nobody types results, tables or fixtures by hand any more. The club spends its time on what only the club can tell.","version":1}]}]}},"gallery":[{"id":"6ab4e8227015637828ae60e8","image":{"id":22,"alt":"Screen recording: one scroll through gorw.club.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:41.033Z","createdAt":"2026-09-24T09:06:41.001Z","url":"/api/media/file/gorw-scroll.mp4","thumbnailURL":null,"filename":"gorw-scroll.mp4","mimeType":"video/mp4","filesize":1381567,"width":null,"height":null,"focalX":null,"focalY":null,"sizes":{"thumb":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"card":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null}}},"size":"full","caption":"One scroll through the site as it is live today."},{"id":"6ab4e8227015637828ae60e9","image":{"id":23,"alt":"Regional league table and player overview.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:41.467Z","createdAt":"2026-09-24T09:06:41.437Z","url":"/api/media/file/gorw-desktop-mid-2.jpg","thumbnailURL":null,"filename":"gorw-desktop-mid-2.jpg","mimeType":"image/jpeg","filesize":145310,"width":2880,"height":1800,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/gorw-desktop-mid-2-480x300.jpg","width":480,"height":300,"mimeType":"image/jpeg","filesize":12618,"filename":"gorw-desktop-mid-2-480x300.jpg"},"card":{"url":"/api/media/file/gorw-desktop-mid-2-1024x640.jpg","width":1024,"height":640,"mimeType":"image/jpeg","filesize":44090,"filename":"gorw-desktop-mid-2-1024x640.jpg"},"wide":{"url":"/api/media/file/gorw-desktop-mid-2-1920x1200.jpg","width":1920,"height":1200,"mimeType":"image/jpeg","filesize":104348,"filename":"gorw-desktop-mid-2-1920x1200.jpg"},"og":{"url":"/api/media/file/gorw-desktop-mid-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":47210,"filename":"gorw-desktop-mid-2-1200x630.jpg"}}},"size":"full","caption":"Tables and players come straight from the results service."},{"id":"6ab4e8227015637828ae60ea","image":{"id":24,"alt":"gorw.club on a phone: opening with fixtures and livestream.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:41.775Z","createdAt":"2026-09-24T09:06:41.744Z","url":"/api/media/file/gorw-mobile-hero.jpg","thumbnailURL":null,"filename":"gorw-mobile-hero.jpg","mimeType":"image/jpeg","filesize":133051,"width":1170,"height":2532,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/gorw-mobile-hero-480x1039.jpg","width":480,"height":1039,"mimeType":"image/jpeg","filesize":45085,"filename":"gorw-mobile-hero-480x1039.jpg"},"card":{"url":"/api/media/file/gorw-mobile-hero-1024x2216.jpg","width":1024,"height":2216,"mimeType":"image/jpeg","filesize":118012,"filename":"gorw-mobile-hero-1024x2216.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/gorw-mobile-hero-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":60635,"filename":"gorw-mobile-hero-1200x630.jpg"}}},"size":"half","caption":"On a phone it is an app, navigation within thumb reach."},{"id":"6ab4e8227015637828ae60eb","image":{"id":25,"alt":"gorw.club on a phone: upcoming matches of all teams.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:42.056Z","createdAt":"2026-09-24T09:06:42.024Z","url":"/api/media/file/gorw-mobile-mid.jpg","thumbnailURL":null,"filename":"gorw-mobile-mid.jpg","mimeType":"image/jpeg","filesize":115877,"width":1170,"height":2532,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/gorw-mobile-mid-480x1039.jpg","width":480,"height":1039,"mimeType":"image/jpeg","filesize":38571,"filename":"gorw-mobile-mid-480x1039.jpg"},"card":{"url":"/api/media/file/gorw-mobile-mid-1024x2216.jpg","width":1024,"height":2216,"mimeType":"image/jpeg","filesize":105748,"filename":"gorw-mobile-mid-1024x2216.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/gorw-mobile-mid-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":31256,"filename":"gorw-mobile-mid-1200x630.jpg"}}},"size":"half","caption":"Every match of every team, typed by nobody."}],"year":"2026","category":"website","services":[{"label":"Concept","id":"6ab4e8227015637828ae60fa"},{"label":"UI/UX design","id":"6ab4e8227015637828ae60fb"},{"label":"Full-stack development","id":"6ab4e8227015637828ae60fc"},{"label":"Data integration","id":"6ab4e8227015637828ae60fd"},{"label":"Hosting & operations","id":"6ab4e8227015637828ae60fe"}],"tech":[{"id":"6ab4e8227015637828ae60f1","label":"Next.js"},{"id":"6ab4e8227015637828ae60f2","label":"Payload CMS"},{"id":"6ab4e8227015637828ae60f3","label":"PostgreSQL"},{"id":"6ab4e8227015637828ae60f4","label":"Tailwind CSS"},{"id":"6ab4e8227015637828ae60f5","label":"Docker"},{"id":"6ab4e8227015637828ae60f6","label":"Coolify"}],"metrics":[{"value":"97","label":"Lighthouse performance, desktop, 09/2026","id":"6ab4e8227015637828ae60ff"},{"value":"100","label":"Lighthouse SEO, 09/2026","id":"6ab4e8227015637828ae6100"},{"value":"3","label":"Teams, updated automatically","id":"6ab4e8227015637828ae6101"}],"liveUrl":"https://gorw.club","featured":true,"order":10,"slug":"gorw-table-tennis","updatedAt":"2026-09-24T09:06:42.205Z","createdAt":"2026-09-23T08:57:15.244Z","_status":"published"},{"id":4,"title":"Sobha Privy Collection","client":"Mag. Sabrina Riegler’s veterinary practice","tagline":"Veterinary care with heart, on a phone too.","excerpt":"The website of a rural practice in Global: warm rather than clinical, with photos from the practice, news as notifications, frequent questions, and the phone call one tap away.","cover":{"id":26,"alt":"vet-dimbach.at home page: the vet with two dogs, headline “Modern veterinary medicine with heart and mind”.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:42.749Z","createdAt":"2026-09-24T09:06:42.712Z","url":"/api/media/file/vet-dimbach-desktop-hero.jpg","thumbnailURL":null,"filename":"vet-dimbach-desktop-hero.jpg","mimeType":"image/jpeg","filesize":239422,"width":2880,"height":1800,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/vet-dimbach-desktop-hero-480x300.jpg","width":480,"height":300,"mimeType":"image/jpeg","filesize":19834,"filename":"vet-dimbach-desktop-hero-480x300.jpg"},"card":{"url":"/api/media/file/vet-dimbach-desktop-hero-1024x640.jpg","width":1024,"height":640,"mimeType":"image/jpeg","filesize":64267,"filename":"vet-dimbach-desktop-hero-1024x640.jpg"},"wide":{"url":"/api/media/file/sobha-privy.png","width":1920,"height":1200,"mimeType":"image/jpeg","filesize":156659,"filename":"sobha-privy.png"},"og":{"url":"/api/media/file/vet-dimbach-desktop-hero-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":73329,"filename":"vet-dimbach-desktop-hero-1200x630.jpg"}}},"body":{"root":{"type":"root","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The starting point","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"People looking for a vet do not want a brochure. They want answers: is the practice open today, what to do in an emergency, how to get an appointment, what other pet owners say.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The solution","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"A site that works like an app on a phone: navigation at the bottom within thumb reach, calling with one tap, news as notifications behind a bell. Plus services, reviews, frequent questions and directions on the map.","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The colours come from the practice itself, a warm rosé instead of clinical blue. The images show the vet with her patients, not people from a stock library.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The result","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"Live since June 2026. Online appointment requests are prepared and come next.","version":1}]}]}},"gallery":[{"id":"6ab4e8247015637828ae6102","image":{"id":27,"alt":"Screen recording: one scroll through vet-dimbach.at.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:43.661Z","createdAt":"2026-09-24T09:06:43.623Z","url":"/api/media/file/vet-dimbach-scroll.mp4","thumbnailURL":null,"filename":"vet-dimbach-scroll.mp4","mimeType":"video/mp4","filesize":469695,"width":null,"height":null,"focalX":null,"focalY":null,"sizes":{"thumb":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"card":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null}}},"size":"full","caption":"One scroll through the site as it is live today."},{"id":"6ab4e8247015637828ae6103","image":{"id":28,"alt":"vet-dimbach.at on a phone: opening with call button.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:44.023Z","createdAt":"2026-09-24T09:06:43.992Z","url":"/api/media/file/vet-dimbach-mobile-hero.jpg","thumbnailURL":null,"filename":"vet-dimbach-mobile-hero.jpg","mimeType":"image/jpeg","filesize":180897,"width":1170,"height":2532,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/vet-dimbach-mobile-hero-480x1039.jpg","width":480,"height":1039,"mimeType":"image/jpeg","filesize":57293,"filename":"vet-dimbach-mobile-hero-480x1039.jpg"},"card":{"url":"/api/media/file/vet-dimbach-mobile-hero-1024x2216.jpg","width":1024,"height":2216,"mimeType":"image/jpeg","filesize":170837,"filename":"vet-dimbach-mobile-hero-1024x2216.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/vet-dimbach-mobile-hero-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":53711,"filename":"vet-dimbach-mobile-hero-1200x630.jpg"}}},"size":"half","caption":"Calling is one tap. The navigation sits at the bottom."},{"id":"6ab4e8247015637828ae6104","image":{"id":29,"alt":"vet-dimbach.at on a phone: reviews and frequent questions.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:44.276Z","createdAt":"2026-09-24T09:06:44.242Z","url":"/api/media/file/vet-dimbach-mobile-mid.jpg","thumbnailURL":null,"filename":"vet-dimbach-mobile-mid.jpg","mimeType":"image/jpeg","filesize":98137,"width":1170,"height":2532,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/vet-dimbach-mobile-mid-480x1039.jpg","width":480,"height":1039,"mimeType":"image/jpeg","filesize":36015,"filename":"vet-dimbach-mobile-mid-480x1039.jpg"},"card":{"url":"/api/media/file/vet-dimbach-mobile-mid-1024x2216.jpg","width":1024,"height":2216,"mimeType":"image/jpeg","filesize":102388,"filename":"vet-dimbach-mobile-mid-1024x2216.jpg"},"wide":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/vet-dimbach-mobile-mid-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":13823,"filename":"vet-dimbach-mobile-mid-1200x630.jpg"}}},"size":"half","caption":"Reviews and frequent questions, before anyone has to ask."},{"id":"6ab4e8247015637828ae6105","image":{"id":30,"alt":"Frequent questions and directions with map.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:44.647Z","createdAt":"2026-09-24T09:06:44.612Z","url":"/api/media/file/vet-dimbach-desktop-mid-2.jpg","thumbnailURL":null,"filename":"vet-dimbach-desktop-mid-2.jpg","mimeType":"image/jpeg","filesize":134617,"width":2880,"height":1800,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/vet-dimbach-desktop-mid-2-480x300.jpg","width":480,"height":300,"mimeType":"image/jpeg","filesize":12763,"filename":"vet-dimbach-desktop-mid-2-480x300.jpg"},"card":{"url":"/api/media/file/vet-dimbach-desktop-mid-2-1024x640.jpg","width":1024,"height":640,"mimeType":"image/jpeg","filesize":42761,"filename":"vet-dimbach-desktop-mid-2-1024x640.jpg"},"wide":{"url":"/api/media/file/vet-dimbach-desktop-mid-2-1920x1200.jpg","width":1920,"height":1200,"mimeType":"image/jpeg","filesize":97655,"filename":"vet-dimbach-desktop-mid-2-1920x1200.jpg"},"og":{"url":"/api/media/file/vet-dimbach-desktop-mid-2-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":42584,"filename":"vet-dimbach-desktop-mid-2-1200x630.jpg"}}},"size":"full","caption":""}],"year":"2026","category":"website","services":[{"label":"Concept","id":"6ab4e8247015637828ae610e"},{"label":"Web design","id":"6ab4e8247015637828ae610f"},{"label":"Development","id":"6ab4e8247015637828ae6110"}],"tech":[{"id":"6ab4e8247015637828ae6109","label":"Next.js"},{"id":"6ab4e8247015637828ae610a","label":"React"},{"id":"6ab4e8247015637828ae610b","label":"TypeScript"}],"metrics":[{"value":"100","label":"Lighthouse SEO, 09/2026","id":"6ab4e8247015637828ae6111"},{"value":"100","label":"Lighthouse best practices, 09/2026","id":"6ab4e8247015637828ae6112"}],"liveUrl":"https://www.vet-dimbach.at","featured":true,"order":20,"slug":"dimbach-veterinary-practice","updatedAt":"2026-09-24T09:06:44.767Z","createdAt":"2026-09-24T09:06:44.666Z","_status":"published"},{"id":2,"title":"WebCloud Studio, portfolio","client":"Personal project","tagline":"A CV that compiles itself first.","excerpt":"The personal portfolio of the developer behind webcloud.: it starts as a terminal, builds itself in front of you and has a mirror mode that runs entirely in the browser.","cover":{"id":31,"alt":"manuel-mayrhofer.tech: “Hi, I’m WebCloud Studio” next to a 3D avatar on dark blue.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:45.250Z","createdAt":"2026-09-24T09:06:45.216Z","url":"/api/media/file/manuel-mayrhofer-desktop-hero.jpg","thumbnailURL":null,"filename":"manuel-mayrhofer-desktop-hero.jpg","mimeType":"image/jpeg","filesize":135336,"width":2880,"height":1800,"focalX":50,"focalY":50,"sizes":{"thumb":{"url":"/api/media/file/manuel-mayrhofer-desktop-hero-480x300.jpg","width":480,"height":300,"mimeType":"image/jpeg","filesize":11903,"filename":"manuel-mayrhofer-desktop-hero-480x300.jpg"},"card":{"url":"/api/media/file/manuel-mayrhofer-desktop-hero-1024x640.jpg","width":1024,"height":640,"mimeType":"image/jpeg","filesize":37673,"filename":"manuel-mayrhofer-desktop-hero-1024x640.jpg"},"wide":{"url":"/api/media/file/thenest.webp","width":1920,"height":1200,"mimeType":"image/jpeg","filesize":92108,"filename":"thenest.webp"},"og":{"url":"/api/media/file/manuel-mayrhofer-desktop-hero-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":45341,"filename":"manuel-mayrhofer-desktop-hero-1200x630.jpg"}}},"body":{"root":{"type":"root","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The idea","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"A developer’s portfolio can start with what developers see every day: a command line. On a first visit a build runs, personality compiles, creativity is injected, then the page stands.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"The build","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"Bilingual, with an illustrated 3D avatar at the top, skills as a toolbox, interests and a CV. The mirror mode is an experiment: it runs entirely on the device, no image ever leaves it.","version":1}]},{"type":"heading","tag":"h2","format":"","indent":0,"version":1,"direction":"ltr","children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"What stayed","version":1}]},{"type":"paragraph","format":"","indent":0,"version":1,"direction":"ltr","textFormat":0,"children":[{"type":"text","detail":0,"format":0,"mode":"normal","style":"","text":"This is where I try things nobody has ordered yet. The idea of a page building itself in front of you lives on in the build on webcloud.’s home page.","version":1}]}]}},"gallery":[{"id":"6ab4e8277015637828ae6113","image":{"id":32,"alt":"Screen recording: terminal start and a scroll through the portfolio.","caption":null,"credit":null,"updatedAt":"2026-09-24T09:06:46.536Z","createdAt":"2026-09-24T09:06:46.504Z","url":"/api/media/file/manuel-mayrhofer-scroll.mp4","thumbnailURL":null,"filename":"manuel-mayrhofer-scroll.mp4","mimeType":"video/mp4","filesize":876699,"width":null,"height":null,"focalX":null,"focalY":null,"sizes":{"thumb":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"card":{"url":null,"width":null,"height":null,"mimeType":null,"files